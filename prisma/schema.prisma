// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum roleUser {
  admin
  user
}

enum mood{
  baik
  biasa
  buruk
}

enum roleML{
  gold
  exp
  mid
  jungle
  roam
}

model User{
  id String @id @db.VarChar(36) @default(uuid())
  email String @db.VarChar(100) @unique
  username String @db.VarChar(100) @unique
  password String @db.VarChar(100) 
  nama String @db.VarChar(100)
  role roleUser
  game_id String
  server_id String @db.VarChar(5)
  otp String? @db.VarChar(100)
  status Boolean @default(false)
  pfp String?
  faceEmbedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usernameUpdatedAt DateTime? 
  absensi Absensi[]
  member TeamMember?

  @@map("users")
}

model Kegiatan{
  id String @id @db.VarChar(36) @default(uuid())
  nama_kegiatan String @db.VarChar(100)
  tanggal_kegiatan DateTime
  jam_mulai String? @db.VarChar(50)
  jam_selesai String? @db.VarChar(50)
  lokasi String? @db.VarChar(255)
  deskripsi String? @db.Text
  onlyTeam Boolean? @default(false)
  attachment String?
  google_event_id String? @db.VarChar(255)
  absensi Absensi[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("kegiatan")
}

model Absensi{
  id Int @default(autoincrement()) @id
  user_id String
  kegiatan_id String
  deskripsi String @db.VarChar(1000)
  mood mood
  bukti String @db.VarChar(100)
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  kegiatan Kegiatan @relation(fields: [kegiatan_id], references: [id], onDelete: Cascade)
  @@map("absensi")
}


model Team{
    id Int @id @default(autoincrement())
    nama_tim String @db.VarChar(50)
    member TeamMember[]

    @@map("teams")
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  teamId   Int
  userId   String  @db.VarChar(36) @unique
  role     roleML
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("teammember")
}

model Berita{
  id String @id @default(uuid())
  link String @db.Text
  title String @db.Text
  coverImage String @db.Text
}

