// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum roleUser {
  admin
  user
}

enum mood {
  baik
  biasa
  buruk
}

enum roleML {
  gold
  exp
  mid
  jungle
  roam
}

enum reportStatus {
  pending
  reviewed
  dismissed
}

model User{
  id String @id @db.VarChar(36) @default(uuid())
  email String @db.VarChar(100) @unique
  username String @db.VarChar(100) @unique
  password String @db.VarChar(100) 
  nama String @db.VarChar(100)
  kelas String? @db.VarChar(30)
  role roleUser
  game_id String
  server_id String @db.VarChar(5)
  otp String? @db.VarChar(100)
  status Boolean @default(false)
  pfp String?
  faceEmbedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usernameUpdatedAt DateTime? 
  absensi Absensi[]
  thread      Thread[]
  threadReply ThreadReply[]
  threadLikes ThreadLike[]
  replyLikes  ReplyLike[]
  reports     Report[]
  member TeamMember?

  @@map("users")
}

model Kegiatan{
  id String @id @db.VarChar(36) @default(uuid())
  nama_kegiatan String @db.VarChar(100)
  tanggal_kegiatan DateTime
  jam_mulai String? @db.VarChar(50)
  jam_selesai String? @db.VarChar(50)
  lokasi String? @db.VarChar(255)
  deskripsi String? @db.Text
  onlyTeam Boolean? @default(false)
  attachment String?
  google_event_id String? @db.VarChar(255)
  absensi Absensi[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("kegiatan")
}

model Absensi{
  id Int @default(autoincrement()) @id
  user_id String
  kegiatan_id String
  deskripsi String @db.VarChar(1000)
  mood mood
  bukti String @db.VarChar(100)
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  kegiatan Kegiatan @relation(fields: [kegiatan_id], references: [id], onDelete: Cascade)
  @@map("absensi")
}


model Team{
    id Int @id @default(autoincrement())
    nama_tim String @db.VarChar(50)
    member TeamMember[]

    @@map("teams")
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  teamId   Int
  userId   String  @db.VarChar(36) @unique
  role     roleML
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("teammember")
}

model Berita{
  id String @id @default(uuid())
  link String @db.Text
  title String @db.Text
  coverImage String @db.Text
}

model Thread{
  id String @id @db.VarChar(36) @default(uuid())
  authorId String
  title String @db.VarChar(150)
  content String @db.Text
  pinned Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ThreadReply[]
  likes ThreadLike[]
  reports Report[]
  @@map("threads")
}

model ThreadReply {
  id Int @id @default(autoincrement())
  threadId String
  authorId String
  content String @db.Text
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt

  thread Thread @relation(fields: [threadId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  likes ReplyLike[]
  reports Report[]

  @@index([threadId])
  @@map("thread_replies")
}

model ThreadLike{
  id Int @id @default(autoincrement())
  threadId String
  userId String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([threadId, userId])
  @@map("thread_likes")
}

model ReplyLike{
  id Int @id @default(autoincrement())
  replyId Int
  userId String
  createdAt DateTime @default(now())

  reply ThreadReply @relation(fields: [replyId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([replyId, userId])
  @@map("reply_likes")
}

model Report {
  id Int @default(autoincrement()) @id
  reporterId String
  threadId String?
  replyId Int? 
  reason String @db.Text
  status reportStatus @default(pending)
  createdAt DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply ThreadReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@map("reports")
}

